<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <IsoShimLib Condition="'$(IsoShimLib)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">../../native/build-mac/libisoshim.dylib</IsoShimLib>
    <IsoShimLib Condition="'$(IsoShimLib)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">../../native/build-linux/libisoshim.so</IsoShimLib>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../IsoShim.cs" />
    <Compile Include="../IsoShimSpike.cs" />
    <Compile Include="../IsoShimBench.cs" />
    <EmbeddedResource Include="../VT3TestPool.iop" LogicalName="VT3TestPool.iop" />
    <None Include="$(IsoShimLib)" CopyToOutputDirectory="PreserveNewest" Condition="'$(IsoShimLib)' != ''" />
  </ItemGroup>
</Project>
