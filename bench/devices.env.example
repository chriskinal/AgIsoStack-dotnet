# Copy to bench/devices.env and fill in.
GATEWAY=user@192.168.77.2          # ssh to the Linux box that runs the relay and the implement
RELAY_HOST=10.77.0.1               # its address on the network the terminal device is on
# RELAY_PORT=2323
# NETEM_DEV=wlan0                  # the gateway interface netem shapes (eth0 for a wired client)
# RELAY_IF=can0                    # CAN interface of the relay   (gateway.sh defaults: hatcan2)
# IMPL_IF=can1                     # CAN interface of the implement (gateway.sh defaults: hatcan3)
IPAD_UDID=                         # xcrun devicectl list devices
ANDROID_SERIAL=                    # adb devices
# AP_PSK=                         # the bench access point's key
